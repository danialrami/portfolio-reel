{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lufs.audio/portfolio-reel/schemas/reel/reel-v1.json",
  "title": "Reels Reel Document v1",
  "description": "The normalized editing/timeline artifact for the phase-0/1 video-only flow. Audio fields remain as an explicit future extension and are not honored by the current CLI surface.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reel_id",
    "output",
    "style",
    "intro",
    "outro",
    "music",
    "clips",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "reel_id": {
      "anyOf": [
        { "const": "" },
        { "type": "string", "pattern": "^reel-[0-9a-f]{8}$" }
      ],
      "description": "Empty is allowed for an in-memory draft; save_reel computes the deterministic id."
    },
    "output": { "$ref": "#/definitions/output" },
    "style": { "$ref": "#/definitions/style" },
    "intro": { "$ref": "#/definitions/intro_outro" },
    "outro": { "$ref": "#/definitions/intro_outro" },
    "music": { "$ref": "#/definitions/music" },
    "clips": {
      "type": "array",
      "items": { "$ref": "#/definitions/clip" },
      "description": "Ordered video clips. An empty array is a valid authoring draft, but cannot render a useful reel."
    },
    "verification": { "$ref": "#/definitions/verification" }
  },
  "definitions": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "fps", "video_codec", "audio_codec", "size"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "fps": { "type": "integer", "minimum": 1, "default": 30 },
        "video_codec": { "type": "string", "minLength": 1, "default": "libx264" },
        "audio_codec": {
          "type": "string",
          "minLength": 1,
          "default": "aac",
          "description": "Reserved for the deferred audio phase."
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+x[0-9]+$",
          "default": "1920x1080"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font", "overlay_bg", "fade_duration"],
      "properties": {
        "font": { "type": "string", "minLength": 1, "default": "DejaVu-Sans-Bold" },
        "overlay_bg": { "type": "string", "minLength": 1, "default": "rgba(0,0,0,0.5)" },
        "fade_duration": { "type": "number", "minimum": 0, "default": 0.5 }
      }
    },
    "intro_outro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "duration"],
      "properties": {
        "text": { "type": "string", "default": "" },
        "duration": { "type": "number", "minimum": 0, "default": 0 }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "volume", "duck_under_speech"],
      "properties": {
        "file": {
          "const": "",
          "description": "Music is deferred; phase-0/1 reel documents leave this empty."
        },
        "volume": { "type": "number", "minimum": 0, "default": 0.15 },
        "duck_under_speech": {
          "const": true,
          "description": "Retained for the future audio phase; no music is rendered now."
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_ref", "trim_in", "trim_out", "order", "overlay"],
      "properties": {
        "capture_ref": {
          "type": "string",
          "pattern": "^rec-[0-9a-f]{8}$"
        },
        "trim_in": { "type": "number", "minimum": 0, "default": 0 },
        "trim_out": { "type": "number", "minimum": 0, "default": 0 },
        "order": { "type": "integer", "default": 1 },
        "overlay": { "$ref": "#/definitions/overlay" }
      },
      "description": "trim_out >= trim_in is enforced by the Python parser/contract because Draft 7 cannot compare sibling numbers."
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "position"],
      "properties": {
        "text": { "type": "string", "default": "" },
        "position": { "type": "string", "minLength": 1, "default": "bottom-left" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ok"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ok": {
          "type": ["boolean", "null"],
          "description": "true means passed, false means violated, null means unverifiable."
        },
        "value": {},
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "shown": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "checks"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["verified", "violated", "unverifiable"]
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/definitions/check" }
        }
      }
    }
  }
}
